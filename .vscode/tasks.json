{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch:esbuild",
			"problemMatcher": "$esbuild-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch:tsc",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"problemMatcher": []
		}
	]
}
